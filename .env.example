PORT=8787
# Optional on Railway; app can detect RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_BASE_URL=
COLORA_ADMIN_KEY=replace-with-a-strong-internal-key
COLORA_SIGNING_SECRET=replace-with-a-long-random-secret
# Railway: use a reference variable to Postgres.DATABASE_URL
DATABASE_URL=
# Only set to require when your PostgreSQL provider requires TLS.
PGSSLMODE=
